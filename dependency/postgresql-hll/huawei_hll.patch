+/* ********BLOCK DATE BEGIN ***************** */
+
+typedef struct {
+    uint8 cur_block_id; /* blockid */
+    uint8 flags;
+    uint8 has_image;
+    uint8 has_data;
+    BlockNumber auxiblk1;
