+
+    /* Inner rel info. */
+    RelOptInfo* m_innerRel;
+
+    /* The set of required outer rels. */
+    Relids m_requiredOuter;
+
+    /* Resource owner for join generation. */
+    ResourceOwner m_resourceOwner;
+
+    /* The target distibution of node group. */
