+typedef PureLibpq::Port PurePort;
+
+#ifndef FREE_AND_RESET
+#define FREE_AND_RESET(ptr)  \
+    do {                     \
+        if (NULL != (ptr)) { \
+            pfree(ptr);      \
+            (ptr) = NULL;    \
+        }                    \
+    } while (0)
+#endif
+
+typedef struct HeartbeatStartupPacket {
+    int channelIdentifier; /* Use local heart beat listening port for channel identifier */
