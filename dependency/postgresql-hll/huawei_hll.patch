+extern AlarmCheckResult GTMStandbyNotAliveChecker(Alarm* alarm, char* buffer);
+extern AlarmCheckResult GTMNotInSyncStatusChecker(Alarm* alarm, char* buffer);
+
+/*
+ * Startup mode
+ */
