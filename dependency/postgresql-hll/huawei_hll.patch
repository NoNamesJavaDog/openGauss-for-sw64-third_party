diff -uprN postgresql-hll-2.14_old/include/cjson/cJSON.h postgresql-hll-2.14/include/cjson/cJSON.h
--- postgresql-hll-2.14_old/include/cjson/cJSON.h	1970-01-01 08:00:00.000000000 +0800
+++ postgresql-hll-2.14/include/cjson/cJSON.h	2020-12-12 17:06:43.094346064 +0800
@@ -0,0 +1,294 @@
+/*
