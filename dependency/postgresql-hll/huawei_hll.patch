diff -uprN postgresql-hll-2.14_old/include/access/cstore_insert.h postgresql-hll-2.14/include/access/cstore_insert.h
--- postgresql-hll-2.14_old/include/access/cstore_insert.h	1970-01-01 08:00:00.000000000 +0800
+++ postgresql-hll-2.14/include/access/cstore_insert.h	2020-12-12 17:06:43.056345574 +0800
@@ -0,0 +1,419 @@
+/*
