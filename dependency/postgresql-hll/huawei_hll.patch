+/* Get the byte length of a multibyte character. */
+#define MB_LEN(mlen, string)           \
+    if ((*string & 0x80) == 0)         \
+        mlen = 1;                      \
+    else if ((*string & 0xe0) == 0xc0) \
+        mlen = 2;                      \
+    else if ((*string & 0xf0) == 0xe0) \
+        mlen = 3;                      \
+    else if ((*string & 0xf8) == 0xf0) \
+        mlen = 4;                      \
+    else                               \
+        mlen = 1;
