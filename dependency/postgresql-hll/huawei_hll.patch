+    }
+
+    inline int GetNumaId()
+    {
+        return m_numaId;
+    }
+
+    inline bool AllSessionClosed()
+    {
+        return (m_sessionCount <= 0);
+    }
+
+    inline bool AllThreadShutDown()
+    {
+        return (m_workerNum <= 0);
+    }
+
+#ifdef ENABLE_MULTIPLE_NODES
