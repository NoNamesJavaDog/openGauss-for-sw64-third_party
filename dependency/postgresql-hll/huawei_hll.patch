+class CudescReader : public BaseObject {
+public:
+    bool next_cudesc_block();
+public:
+    FieldTimeCuDescBlock cudesc_block;
+    Relation cudesc_rel;
+private:
+    void load_cudesc();
+    void load_time_tscudesc(Relation idex_rel);
+    void load_field_tscudesc(Relation idx_rel);
+
+};
+
+class CudescReaderMinHeap : public BaseObject {
+public:
+    CudescReaderMinHeap(CudescReader* elements, int max_size);
