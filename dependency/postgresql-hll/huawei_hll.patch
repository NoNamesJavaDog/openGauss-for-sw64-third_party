+// chain
+class vechashtable : public BaseObject {
+public:
+    vechashtable(int hashSize) : m_size(hashSize), m_data(0)
+    {
+        m_data = (hashCell**)palloc0(m_size * sizeof(hashCell*));
+    }
+    // depend the sub class to init the member variable.
+    ~vechashtable()
+    {
+        if (m_data)
+            pfree(m_data);
+
+        m_data = NULL;
+        m_size = 0;
+    }
+
+    void Reset()
+    {
+        Assert(m_size != 0);
+        m_data = (hashCell**)palloc0(m_size * sizeof(hashCell*));
+    }
