+/* XLOG stuff */
+#define XLOG_TBLSPC_CREATE 0x00
+#define XLOG_TBLSPC_DROP 0x10
+#define XLOG_TBLSPC_RELATIVE_CREATE 0x20
+
+#define TABLESPACE_USAGE_SLOT_NUM 65536U
