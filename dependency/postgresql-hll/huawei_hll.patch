diff -uprN postgresql-hll-2.14_old/include/include/storage/bufmgr.h postgresql-hll-2.14/include/include/storage/bufmgr.h
--- postgresql-hll-2.14_old/include/include/storage/bufmgr.h	1970-01-01 08:00:00.000000000 +0800
+++ postgresql-hll-2.14/include/include/storage/bufmgr.h	2020-12-12 17:06:43.268348309 +0800
@@ -0,0 +1,310 @@
+/* -------------------------------------------------------------------------
+ *
+ * bufmgr.h
+ *	  POSTGRES buffer manager definitions.
+ *
+ *
