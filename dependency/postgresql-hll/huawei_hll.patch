+    if (conn != NULL) {                  \
+        closePGconn(conn);               \
+        freePGconn(conn);                \
+        conn = NULL;                     \
+    }
+
+#define CLOSE_CONNECTION(con)            \
+    do {                                 \
+        close_and_reset_connection(con); \
+        assert(NULL == con);             \
+        return -1;                       \
+    } while (0)
+
+#define CLEAR_AND_CLOSE_CONNECTION(node_result, con) \
+    do {                                             \
+        PQclear(node_result);                        \
