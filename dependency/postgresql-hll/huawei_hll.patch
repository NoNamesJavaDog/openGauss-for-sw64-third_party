+    XLogRecPtr* recptr, const char* conninfo, ReplConnTarget conn_target, const char* slotname);
+extern StringInfo get_rcv_slot_name(void);
+extern XLogRecPtr GetWalRcvWriteRecPtr(XLogRecPtr* latestChunkStart);
