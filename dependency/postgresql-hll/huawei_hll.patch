+typedef enum FillFetchState {
+    FETCHED_NONE,           /* initial state or initial new group state */
+    FETCHED_EXIST,          /* slot fetched from sub node is not NULL */
+    FETCHED_FILLING,        /* fill NULL slot in the last group */
+    FETCHED_RETURN,         /* return slot in the last group */
+    FETCHED_GROUP_FILLING,  /* fill NULL slot in new group */
