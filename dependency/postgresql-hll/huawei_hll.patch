+				if (isTransition)
+				{
+					pvalue = DirectFunctionCall1(ftod,pVal[i]);
+					cell->m_val[idx].val =  pvalue;
+					cell->m_val[idx + 1].val = 1; //count set 1
+					if (is_samp)
+					{
+						cell->m_val[idx + 2].val = DirectFunctionCall2(float8mul, pvalue, pvalue);
+					}
+				}
+				else
+				{
+					transarray = DatumGetArrayTypeP(pVal[i]);
