+
+/* Insert select shippability flags */
+#define INSEL_SHIPPABLE_NCOL 0
+#define INSEL_SHIPPABLE_DCOL 1
+#define INSEL_UNSHIPPABLE_COL 2
+
+typedef struct {
+    bool is_randomfunc_shippable;
+    bool is_nextval_shippable;
