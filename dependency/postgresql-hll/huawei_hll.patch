+
+typedef struct ResourcePool {
+    Oid rpoid;                      /* resource pool id */
+    Oid parentoid;                  /* resource pool id */
+    int ref_count;                  /* ref count of the resource pool */
+    int active_points;              /* the count of active statements in the resource pool */
