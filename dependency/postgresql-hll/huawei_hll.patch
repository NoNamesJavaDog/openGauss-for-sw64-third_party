+    uint32 totalentries;
+    uint32 allocentries; /* allocated length of entries[] */
+
+    MemoryContext keyCtx; /* used to hold key and entry data */
+
+    bool isVoidRes; /* true if query is unsatisfiable */
+} GinScanOpaqueData;
+
