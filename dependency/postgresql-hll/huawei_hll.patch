+    CudescReader* pop();
+    bool is_empty();
+    void insert(CudescReader* elements);
+private:
+    void fix_up_min_heap(int i);
+    void fix_down_min_heap(int i);
+    static bool compare(CudescReader *left, CudescReader *right);
+private:
+    int current_size;
+    int max_size;
+    CudescReader* heap;
+};
