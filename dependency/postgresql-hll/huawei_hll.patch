+typedef struct {
+    RelFileNode rnode;
+    ForkNumber forknum;
+    BlockNumber blkno;
+} RedoBufferTag;
+
+typedef struct {
+    Page page;  // pagepointer
+    Size pagesize;
+} RedoPageInfo;
+
+typedef struct {
+    XLogRecPtr lsn; /* block cur lsn */
+    Buffer buf;
+    RedoBufferTag blockinfo;
