+inline int getPower2LessNum(int num)
+{
+    int i = 1;
+    int count = 0;
+
+    for (;;) {
+        num = num / 2;
+        if (num == 0)
+            break;
+        count++;
+    }
+    i <<= count;
+
+    return i;
+}
+
+inline int getPower2NextNum(int num)
+{
+    int i = 1;
+    int count = 0;
+
+    // guard too long number
+    if (num > INT_MAX / 2)
+        num = INT_MAX / 2;
+
+    num = num - 1;
+    for (;;) {
+        num = num / 2;
+        if (num == 0)
+            break;
+        count++;
+    }
+
+    i <<= (count + 1);
+    return i;
+}
