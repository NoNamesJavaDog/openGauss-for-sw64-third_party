+#define CPUACCT_USAGE "cpuacct.usage"
+
+#define EXCEPT_ALL_KINDS 2
+
+#define EXCEPT_ERROR -2
+#define EXCEPT_NONE -1
+#define EXCEPT_ABORT 0
