+
+extern THR_LOCAL ThreadInstrumentation* runtimeThreadInstr;
+
+#define trackpoint_number 10
+#define DN_NUM_STREAMS_IN_CN(num_streams, gather_count, query_dop) ((num_streams + gather_count) * query_dop)
+
