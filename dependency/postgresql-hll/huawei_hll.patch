+} Track;
+
+typedef struct RoughCheckInfo {
+    uint64 m_CUFull;
+    uint64 m_CUNone;
+    uint64 m_CUSome;
+
+    inline void IncFullCUNum()
+    {
+        ++m_CUFull;
+    }
+    inline void IncNoneCUNum()
+    {
+        ++m_CUNone;
+    }
+    inline void IncSomeCUNum()
+    {
