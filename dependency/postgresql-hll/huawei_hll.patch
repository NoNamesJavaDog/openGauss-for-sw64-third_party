+CATALOG(pg_range,3541) BKI_WITHOUT_OIDS BKI_SCHEMA_MACRO
+{
+    Oid            rngtypid;        /* OID of owning range type */
+    Oid            rngsubtype;      /* OID of range's element type (subtype) */
