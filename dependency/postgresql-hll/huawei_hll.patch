+#define Config_Type_Names()                                                                       \
+    const char *const config_type_names[] = { /* GTMC_BOOL */ "bool", /* GTMC_INT */ "integer",   \
+                                              /* GTMC_REAL */ "real", /* GTMC_STRING */ "string", \
+                                              /* GTMC_ENUM */ "enum" }
