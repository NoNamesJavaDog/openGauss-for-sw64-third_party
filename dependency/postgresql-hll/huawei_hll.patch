+} SortHashInfo;
+
+typedef struct StreamTime {
+    bool need_timer;
+    bool running;
+    instr_time starttime;
+    instr_time counter;
+    double firsttuple;
+    double tuplecount;
+    double startup; /* Total startup time (in seconds) */
