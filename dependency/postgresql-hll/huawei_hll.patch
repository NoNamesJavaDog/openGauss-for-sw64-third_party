+    GLOBALSETTINGNAME,
+    GLOBALSETTINGOID,
+    INDEXRELID,
+    LANGNAME,
+    LANGOID,
+    NAMESPACENAME,
+    NAMESPACEOID,
+    OPERNAMENSP,
+    OPEROID,
+    OPFAMILYAMNAMENSP,
+    OPFAMILYOID,
+    PARTRELID,
+    PARTPARTOID,
+    PGJOBID,
+    PGJOBPROCID,
+    PGOBJECTID,
+#ifdef PGXC
+    PGXCCLASSRELID,
+    PGXCGROUPNAME,
+    PGXCGROUPOID,
+    PGXCNODENAME,
+    PGXCNODEOID,
+    PGXCNODEIDENTIFIER,
+    PGXCRESOURCEPOOLNAME,
+    PGXCRESOURCEPOOLOID,
+    PGXCWORKLOADGROUPNAME,
+    PGXCWORKLOADGROUPOID,
+    PGXCAPPWGMAPPINGNAME,
+    PGXCAPPWGMAPPINGOID,
+    PGXCSLICERELID,
+#endif
+    POLICYLABELNAME,
+    POLICYLABELOID,
