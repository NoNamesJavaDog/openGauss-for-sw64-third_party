+
+    bool isRowTriggerShippable; /* true if all row triggers are shippable. */
+#ifdef ENABLE_MOT
+    JitExec::JitContext* mot_jit_context;   /* MOT JIT context required for executing LLVM jitted code */
+#endif
+} EState;
