+	FunctionCallInfoData finfo;
+	ArrayType  *transarray = NULL;
+	float8	   *transvalues = NULL;
+	Datum		  pvalue;
+
+	finfo.arg = &args[0];
+
+	for (i = 0 ; i < nrows; i++)
+	{
+		cell = loc[i];
+		if (cell && IS_NULL(flag[i]) == false) //only do when not null
+		{
+			if (IS_NULL(cell->m_val[idx].flag))
