+            } else {                                                \
+                new_item.ret_type = RET_TYPE_FAIL;                  \
+                new_item.dat_size = (__reqsize);                    \
+            }                                                       \
+            new_item.req_usec = INSTR_TIME_GET_MICROSEC(__difTime); \
