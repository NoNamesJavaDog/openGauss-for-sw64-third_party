+
+extern void FileAsyncCUClose(File* vfdList, int32 vfdnum);
+extern int FileAsyncRead(AioDispatchDesc_t** dList, int32 dn);
+extern int FileAsyncWrite(AioDispatchDesc_t** dList, int32 dn);
