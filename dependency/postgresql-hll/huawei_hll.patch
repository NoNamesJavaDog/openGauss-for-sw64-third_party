+typedef int slock_t;
+
+#define TAS(lock) _check_lock((slock_t*)(lock), 0, 1)
+#define S_UNLOCK(lock) _clear_lock((slock_t*)(lock), 0)
+#endif /* _AIX */
+
+/* These are in s_lock.c */
+
+#if defined(sun3) /* Sun3 */
+#define HAS_TEST_AND_SET
+
+typedef unsigned char slock_t;
+#endif
+
