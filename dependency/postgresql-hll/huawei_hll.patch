+    volatile int m_listenerNum;
+    volatile int m_expectWorkerNum;
+    volatile int m_idleWorkerNum;
+    volatile int m_pendingWorkerNum;
+    volatile int m_streamNum;
+    volatile int m_idleStreamNum;
