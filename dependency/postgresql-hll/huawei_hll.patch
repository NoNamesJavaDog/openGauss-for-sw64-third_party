+
+    void assemableMsg(char msgtype, StringInfo msgBuf, bool trigger_ship = false);
+
+    // run with execute message
+    void runMsg(StringInfo exec_message);
+
+    void connect();
+
+    void handleResponse();
+
+    void sendParseIfNecessary();
