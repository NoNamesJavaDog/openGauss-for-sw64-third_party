+    void last_time_pos(uint32& tagid, uint32& cuid);
+    void last_field_pos(int field_idx, uint32& tagid, uint32& cuid);
+    Tsdb::TsCUDesc* next_time_cudesc();
+    Tsdb::TsCUDesc* next_field_cudesc(int field_idx);
+    uint32 get_time_loaded_num();
+    bool block_loaded_over();
+};
