diff -uprN postgresql-hll-2.14_old/include/utils/globalplancore.h postgresql-hll-2.14/include/utils/globalplancore.h
--- postgresql-hll-2.14_old/include/utils/globalplancore.h	1970-01-01 08:00:00.000000000 +0800
+++ postgresql-hll-2.14/include/utils/globalplancore.h	2020-12-12 17:06:43.398349987 +0800
@@ -0,0 +1,269 @@
+/*---------------------------------------------------------------------------------------
+ *
+ * globalplancore.h
+ *
+ *        global plan cache kernel header
+ *
+ *  __  __ __   __  ___    ___
+ *  \ \/ / \ \ / / |   \  | _ )
