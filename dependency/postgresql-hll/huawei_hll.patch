+#define ATT_IS_CHAR_TYPE(atttypid) (atttypid == BPCHAROID || atttypid == VARCHAROID || atttypid == NVARCHAR2OID)
+#define ATT_IS_NUMERIC_TYPE(atttypid) (atttypid == NUMERICOID)
