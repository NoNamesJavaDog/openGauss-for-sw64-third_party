diff -uprN postgresql-hll-2.14_old/include/include/gssrpc/xdr.h postgresql-hll-2.14/include/include/gssrpc/xdr.h
--- postgresql-hll-2.14_old/include/include/gssrpc/xdr.h	1970-01-01 08:00:00.000000000 +0800
+++ postgresql-hll-2.14/include/include/gssrpc/xdr.h	2020-12-12 17:06:43.198347406 +0800
@@ -0,0 +1,338 @@
+/* @(#)xdr.h	2.2 88/07/29 4.0 RPCSRC */
+/*
+ * Copyright (c) 2010, Oracle America, Inc.
+ *
+ * All rights reserved.
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions are met:
