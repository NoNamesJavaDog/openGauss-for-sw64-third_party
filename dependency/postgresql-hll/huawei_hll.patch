+ * ---------------------------------------------------------------------------------------
+ * 
+ * syscall_lock.h
+ * 
+ * 
+ * 
+ * IDENTIFICATION
+ *        src/include/utils/syscall_lock.h
+ *
+ * NOTE
+ *    some function in lib has not thread safe version , use lock to protect them 
+ *
