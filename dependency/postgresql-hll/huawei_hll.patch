+
+#pragma once
+#include <cstdio>
+#include <string>
+
+#define MAX_VAL_LEN 1024
+#define NAMEDATALEN 64
+#define NAME_CNT 4
+
+struct ConstKeyValue {
+    char key[NAMEDATALEN + 1];
+    char value[MAX_VAL_LEN];
+    size_t valsize;
+};
+
+class CStringsMap {
+public:
+    CStringsMap();
+    CStringsMap(const CStringsMap &other);
+    CStringsMap &operator = (const CStringsMap &other);
+    ~CStringsMap();
+    void set(const char *key, const char *value, size_t valsize = 0);
+    void clear();
+    const char *find(const char *key) const;
+    const char *find(const char *key, size_t *size) const;
+    const size_t Size() const
+    {
+        return size;
+    }
+    ConstKeyValue *at(size_t i) const
+    {
+        if (i < size) {
+            return &k_v_map[i];
+        } else {
+            return NULL;
+        }
+    }
+
+private:
+    size_t size;
+    struct ConstKeyValue *k_v_map;
+    const size_t index(const char *key) const;
+};
