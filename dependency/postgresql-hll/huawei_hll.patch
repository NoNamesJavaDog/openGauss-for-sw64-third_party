+        m_id = 0;
+        m_format = -1;
+        m_nodeType = 'C';
+        m_quote = '"';
+        m_escape = '"';
+        m_eol = NULL;
+        m_header = false;
+        m_nodeNum = 0;
+        m_nodeName = NULL;
+        m_fixSize = 0;
+        m_prefix = NULL;
+        m_fileheader = NULL;
+    }
+    ~CmdBegin()
+    {
