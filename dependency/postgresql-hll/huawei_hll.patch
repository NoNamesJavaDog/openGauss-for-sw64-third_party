+#ifndef PG_PARTITION_FN_H
+#define PG_PARTITION_FN_H
+
+#include "postgres.h"
+#include "knl/knl_variable.h"
+#include "catalog/indexing.h"
+#include "catalog/pg_type.h"
+#include "nodes/parsenodes.h"
