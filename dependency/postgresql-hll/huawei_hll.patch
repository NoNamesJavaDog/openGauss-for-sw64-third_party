+ */
+
+#ifndef SRC_INCLUDE_VECTORSONIC_VSONICARRAY_H_
+#define SRC_INCLUDE_VECTORSONIC_VSONICARRAY_H_
+
+#include "vecexecutor/vechashjoin.h"
