+#define securec_check(errno, charList, ...)                                                                            \
+    {                                                                                                                  \
+        if (EOK != errno) {                                                                                            \
+            freeSecurityFuncSpace(charList, ##__VA_ARGS__);                                                            \
+            switch (errno) {                                                                                           \
+                case EINVAL:                                                                                           \
