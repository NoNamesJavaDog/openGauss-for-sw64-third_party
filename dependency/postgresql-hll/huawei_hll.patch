diff -uprN postgresql-hll-2.14_old/include/tsearch/ts_zh_ngram.h postgresql-hll-2.14/include/tsearch/ts_zh_ngram.h
--- postgresql-hll-2.14_old/include/tsearch/ts_zh_ngram.h	1970-01-01 08:00:00.000000000 +0800
+++ postgresql-hll-2.14/include/tsearch/ts_zh_ngram.h	2020-12-12 17:06:43.391349896 +0800
@@ -0,0 +1,293 @@
+/*
