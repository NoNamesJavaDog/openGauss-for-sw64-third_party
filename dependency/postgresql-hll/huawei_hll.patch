+++ postgresql-hll-2.14/include/include/krad.h	2020-12-12 17:06:43.216347638 +0800
@@ -0,0 +1,265 @@
+/* -*- mode: c; c-basic-offset: 4; indent-tabs-mode: nil -*- */
+/*
