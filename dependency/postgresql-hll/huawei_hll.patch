+#define GSCGROUP_MEDIUM_TIMESHARE "Medium"
+#define GSCGROUP_LOW_TIMESHARE "Low"
+#define GSCGROUP_DEFAULT_BACKEND "DefaultBackend"
+#define GSCGROUP_VACUUM "Vacuum"
+#define GSCGROUP_TOP_WORKLOAD "TopWD"
