+#define XLOG_FROM_ARCHIVE (1 << 0) /* Restored using restore_command */
+#define XLOG_FROM_PG_XLOG (1 << 1) /* Existing file in pg_xlog */
+#define XLOG_FROM_STREAM (1 << 2)  /* Streamed from master */
