+#ifndef PLANNODES_H
+#define PLANNODES_H
+
+#include "access/sdir.h"
+#include "foreign/foreign.h"
+#include "nodes/bitmapset.h"
+#include "nodes/primnodes.h"
+#include "utils/partitionmap.h"
+#include "utils/partitionmap_gs.h"
