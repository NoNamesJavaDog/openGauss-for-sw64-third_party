+}
+
+#endif /* __ns32k__ */
+
+#if defined(__alpha) || defined(__alpha__) /* Alpha */
+/*
+ * Correct multi-processor locking methods are explained in section 5.5.3
+ * of the Alpha AXP Architecture Handbook, which at this writing can be
