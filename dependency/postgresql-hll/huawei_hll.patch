+#ifndef cpu_relax
+// New lock
+#if  defined(__x86_64__) || defined(__x86__)
+#define cpu_relax() asm volatile("pause\n": : :"memory")
+#else                                               // some web says yield:::memory
+#define cpu_relax() asm volatile("" : : : "memory") // equivalent to "rep; nop"
+#endif
+#endif
