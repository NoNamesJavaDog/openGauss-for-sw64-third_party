+    FILL_FIRST_COLUMN,      /* fill_first column */
+    FILL_AVERAGE_COLUMN     /* fill_avg column */
+} FillColumnType;
+
+typedef enum FillType {
+    FILL_NONE,              /* only time_fill in sql statement */
+    FILL_FIRST,             /* only time_fill and fill_first in sql statement */
+    FILL_LAST,              /* only time_fill and fill_last in sql statement */
+    FILL_AVERAGE            /* only time_fill and fill_avg in sql statement */
