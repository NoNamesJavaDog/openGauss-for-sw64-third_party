+    /* bloom filter functions */
+    void pushDownFilterIfNeed();
+
+    /* clean functions */
+    void finishJoinPartition(uint32 partIdx);
+
+    void closePartFiles(uint32 partIdx);
+
+    void releaseAllFileHandlerBuffer(bool isInner);
