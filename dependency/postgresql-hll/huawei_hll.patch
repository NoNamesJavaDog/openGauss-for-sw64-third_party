+#ifndef GAUSS_CODE_SRC_INCLUDE_ACCESS_CSTORE_VECTOR_H
+#define GAUSS_CODE_SRC_INCLUDE_ACCESS_CSTORE_VECTOR_H
+
+#include "access/cstore_minmax_func.h"
