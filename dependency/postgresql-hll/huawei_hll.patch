@@ -0,0 +1,88 @@
+/* -------------------------------------------------------------------------
+ *
+ * walsender.h
+ *	  Exports from replication/walsender.c.
+ *
+ * Portions Copyright (c) 2010-2012, PostgreSQL Global Development Group
+ *
