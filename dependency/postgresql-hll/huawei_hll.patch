diff -uprN postgresql-hll-2.14_old/include/access/dfs/dfs_wrapper.h postgresql-hll-2.14/include/access/dfs/dfs_wrapper.h
--- postgresql-hll-2.14_old/include/access/dfs/dfs_wrapper.h	1970-01-01 08:00:00.000000000 +0800
+++ postgresql-hll-2.14/include/access/dfs/dfs_wrapper.h	2020-12-12 17:06:43.059345612 +0800
@@ -0,0 +1,484 @@
+/*
+ * Copyright (c) 2020 Huawei Technologies Co.,Ltd.
+ *
+ * openGauss is licensed under Mulan PSL v2.
+ * You can use this software according to the terms and conditions of the Mulan PSL v2.
