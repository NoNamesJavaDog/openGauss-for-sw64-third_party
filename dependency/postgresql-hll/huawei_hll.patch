diff -uprN postgresql-hll-2.14_old/include/nodes/readfuncs.h postgresql-hll-2.14/include/nodes/readfuncs.h
--- postgresql-hll-2.14_old/include/nodes/readfuncs.h	1970-01-01 08:00:00.000000000 +0800
+++ postgresql-hll-2.14/include/nodes/readfuncs.h	2020-12-12 17:06:43.323349019 +0800
@@ -0,0 +1,33 @@
+/* -------------------------------------------------------------------------
+ *
+ * readfuncs.h
+ *	  header file for read.c and readfuncs.c. These functions are internal
+ *	  to the stringToNode interface and should not be used by anyone else.
+ *
+ * Portions Copyright (c) 1996-2012, PostgreSQL Global Development Group
+ * Portions Copyright (c) 1994, Regents of the University of California
+ *
+ * src/include/nodes/readfuncs.h
+ *
+ * -------------------------------------------------------------------------
+ */
+#ifndef READFUNCS_H
