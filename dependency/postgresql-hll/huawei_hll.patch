diff -uprN postgresql-hll-2.14_old/include/include/access/xlog_basic.h postgresql-hll-2.14/include/include/access/xlog_basic.h
--- postgresql-hll-2.14_old/include/include/access/xlog_basic.h	1970-01-01 08:00:00.000000000 +0800
+++ postgresql-hll-2.14/include/include/access/xlog_basic.h	2020-12-12 17:06:43.143346696 +0800
@@ -0,0 +1,397 @@
+/*
+ * Portions Copyright (c) 2020 Huawei Technologies Co.,Ltd.
+ * Portions Copyright (c) 1996-2013, PostgreSQL Global Development Group
+ * Portions Copyright (c) 1994, Regents of the University of California
+ *
