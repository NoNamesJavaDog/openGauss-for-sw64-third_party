+} InstrumentOption;
+
+/* Mark the DFS storage system type */
+typedef enum DFSType {
+    DFS_HDFS = 1, /* Hadoop HDFS storage system              */
+    DFS_OBS = 2,  /* OBS key-value storage system			   */
