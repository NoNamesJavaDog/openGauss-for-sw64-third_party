+typedef struct RedoItem_s {
+    /* Old version. */
+    bool oldVersion;
+    bool needImmediateCheckpoint;
+    bool needFullSyncCheckpoint;
+    /* Number of workers sharing this item. */
+    uint32 shareCount;
+    /* Id of the worker designated to apply this item. */
