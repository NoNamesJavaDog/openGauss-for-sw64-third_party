+{
+    register int _res;
+
+    __asm__ __volatile__("	movl 	$1, %0			\n"
+                         "	bbssi	$0, (%2), 1f	\n"
+                         "	clrl	%0				\n"
+                         "1: \n"
+                         : "=&r"(_res), "+m"(*lock)
+                         : "r"(lock)
+                         : "memory");
