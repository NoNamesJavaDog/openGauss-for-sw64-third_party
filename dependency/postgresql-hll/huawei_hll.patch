+    double dn1totalRowCnts; /* reltuples from DN1. */
+    double* dndistinct;     /* stadndistinct for DN1 */
+    double* correlations;   /* correlation of stats for DN1 */
+    int num_samples;        /* how many sample rows receive from DN. */
