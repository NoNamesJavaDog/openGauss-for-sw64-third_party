+class BaseError : public BaseObject {
+public:
+    BaseError()
+    {
+        m_desc = NULL;
+        Reset();
+    }
+    virtual ~BaseError()
+    {
+    }
+
+    virtual void Serialize(StringInfo buf);
+
+    virtual void Deserialize(StringInfo buf);
+
+    virtual void serializeMaxNumOfValue(StringInfo buf) = 0;
