+
+    /* Skew Info for join outer side. */
+    List* m_outerSkewInfo;
+
+    /* Skew info. */
+    List** m_skewInfo;
+
+    /* If this is a outer stream. */
+    bool m_isOuterStream;
+};
+
+class AggSkewInfo : public SkewInfo {
