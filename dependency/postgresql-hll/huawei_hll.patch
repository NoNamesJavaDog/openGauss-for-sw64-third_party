+                         "       or      %1, %0, 1   \n"
+                         "       sc      %1, %2      \n"
+                         "       xori    %1, 1       \n"
+                         "       or      %0, %0, %1  \n"
+                         "       sync                \n"
+                         "       .set pop              "
