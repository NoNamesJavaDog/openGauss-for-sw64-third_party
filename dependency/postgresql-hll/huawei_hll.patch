+
+    /* Local roundrobin the tuple through memory. */
+    void localRoundRobinStream(TupleTableSlot* tuple);
+
+    /* Hybrid Stream Type. */
+    void hybridStream(TupleTableSlot* tuple, DestReceiver* self);
