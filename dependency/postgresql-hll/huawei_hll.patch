+struct dirent {
+    long d_ino;
+    unsigned short d_reclen;
+    unsigned short d_namlen;
+    char d_name[MAX_PATH];
+};
+
+typedef struct DIR DIR;
+
+DIR* opendir(const char*);
+struct dirent* readdir(DIR*);
+int closedir(DIR*);
+
+#endif
