+/* ---------------------------------------------------------------------------------------
+ * 
+ * xlogreader.h
+ *        Definitions for the generic XLog reading facility
+ * Portions Copyright (c) 2020 Huawei Technologies Co.,Ltd.
+ * Portions Copyright (c) 2013-2015, PostgreSQL Global Development Group 
+ *
