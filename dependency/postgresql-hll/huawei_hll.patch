+/* currently, there's no need for list_intersection_int etc */
+
+extern gtm_List* gtm_list_difference(gtm_List* list1, gtm_List* list2);
+extern gtm_List* gtm_list_difference_ptr(gtm_List* list1, gtm_List* list2);
