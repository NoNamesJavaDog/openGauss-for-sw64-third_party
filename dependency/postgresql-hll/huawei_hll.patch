--- postgresql-hll-2.14_old/include/include/utils/atomic_arm.h	1970-01-01 08:00:00.000000000 +0800
+++ postgresql-hll-2.14/include/include/utils/atomic_arm.h	2020-12-12 17:06:43.281348477 +0800
@@ -0,0 +1,90 @@
