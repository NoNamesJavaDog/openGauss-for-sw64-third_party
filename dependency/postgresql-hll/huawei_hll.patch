+
+    /* Get the dummy attribute. */
+    bool isDummy();
+
+    /* Get the stream smp distriType. */
+    bool isLocalStream();
+
+    /* Copy snapshot. */
+    void copySnapShot();
+
+    /* Wait thread ID ready. */
+    void waitThreadIdReady();
