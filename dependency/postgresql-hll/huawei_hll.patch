+    INSTRUMENT_TIMER = 1 << 0,   /* needs timer (and row counts) */
+    INSTRUMENT_BUFFERS = 1 << 1, /* needs buffer usage */
+    INSTRUMENT_ROWS = 1 << 2,    /* needs row count */
