+            cJSON_free(m_nodeName);
+        if (m_prefix)
+            cJSON_free(m_prefix);
+        if (m_fileheader)
+            cJSON_free(m_fileheader);
+    }
+};
+
+struct CmdResponse : public CmdBase {
+    int m_result;
+    char* m_reason;
+    CmdResponse() : m_result(0), m_reason(NULL)
+    {
+    }
+
+    ~CmdResponse()
+    {
