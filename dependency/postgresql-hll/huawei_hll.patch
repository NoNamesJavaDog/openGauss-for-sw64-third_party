+		}
+	}
+
+    if (mask != 0)
+        ereport(ERROR,
+                (errcode(ERRCODE_NUMERIC_VALUE_OUT_OF_RANGE),
+                 errmsg("bigint out of range")));
+
+    PG_GETARG_VECTOR(3)->m_rows = nvalues;
+    PG_GETARG_VECTOR(3)->m_desc.typeId = INT8OID;
+    return PG_GETARG_VECTOR(3);
