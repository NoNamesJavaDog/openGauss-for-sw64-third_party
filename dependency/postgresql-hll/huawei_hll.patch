+extern void select_best_grantor(
+    Oid roleId, AclMode privileges, AclMode ddl_privileges, const Acl* acl, Oid ownerId,
+        Oid* grantorId, AclMode* grantOptions, AclMode* ddl_grantOptions, bool is_dbe_perf = false);
+
