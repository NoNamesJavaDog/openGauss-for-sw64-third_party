+     * @return filename list: data filename list only.
+     */
+    List* getDataFileDeduplication();
+
+private:
+    /*
+     * Min-max filter, try to skip carbondata blocklet.
+     * @IN currentBlocklet: current blocklet index
+     * @Out bool: true : skip current blocklet;
