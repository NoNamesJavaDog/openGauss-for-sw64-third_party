+#ifndef GS_POLICY_MAP_H_
+#define GS_POLICY_MAP_H_
+
+#include <map>
+#include "policy_memory_alloc.h"
+#include "policy_set.h"
+#include <unordered_map>
+
+namespace policy_memory
+{
+    template<class _Key,
+             class _Ty,
+             Memory_allocator::MemoryContextType type = Memory_allocator::MemoryCxt_policy_instance,
+             class _Pr = std::less<_Key>,
+             class _Alloc = Memory_allocator::MemoryContextAdapterAllocator<std::pair<const _Key, _Ty>, type> >
+    class pg_map
+        : public std::map<_Key, _Ty, _Pr, _Alloc> {
+        public:
+            using std::map<_Key, _Ty, _Pr, _Alloc>::map;
+    };
+
+    /*
+      replace standard dynamic memory allocation (on heap) to local thread memory usage (preallocated memory on thread)
+      support for sdt::unordered_set
+    */
+    template<class _Key,
+             class _T,
+             Memory_allocator::MemoryContextType type = Memory_allocator::MemoryCxt_policy_instance,
+             class _Hash = policy_memory::PgMemoryKeyHash<_Key>,
+             class _Pred = policy_memory::PgMemoryEqualTo<_Key>,
+             class _Alloc = Memory_allocator::MemoryContextAdapterAllocator<std::pair<const _Key, _T>, type> >
+    class pg_unordered_map
+        : public std::unordered_map<_Key, _T, _Hash, _Pred, _Alloc> {
+        public:
+            using std::unordered_map<_Key, _T, _Hash, _Pred, _Alloc>::unordered_map;
+    };
+}
+
+#endif /* GS_POLICY_MAP_H_ */
