+ * ---------------------------------------------------------------------------------------
+ * 
+ * gs_bitmap.h
+ *     about null bitmap set/query actions
+ *     1.  bitmap_size
+ *     2.  bitmap_been_set
+ *     3.  bitmap_set
+ * 
+ * 
