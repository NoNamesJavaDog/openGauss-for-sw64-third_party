-        if (storage)
-            storage->deallocate(ti);
-        storage = make_sized_row(ncol_, ts_, ti);
-    }
-    storage->ncol_ = ncol_;
-    rowversion v1 = ver_.stable();
-    while (1) {
-        if (f.size() == 1)
-            storage->cols_[f[0]] = cols_[f[0]];
-        else
-            memcpy(storage->cols_, cols_, sizeof(cols_[0]) * storage->ncol_);
-        rowversion v2 = ver_.stable();
