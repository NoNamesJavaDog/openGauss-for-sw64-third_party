-  }
-  if(children < 1 || (children != 1 && !dofork))
-    usage();
-  if (!test)
-      test = testrunner::first();
-
-  printf("%s, w %d, test %s, children %d\n",
-         udpflag ? "udp" : "tcp", window,
-         test->name().c_str(), children);
-
-  fflush(stdout);
-
-  if (dofork) {
-      for(i = 0; i < children; i++){
-          int ptmp[2];
-          int r = pipe(ptmp);
-          always_assert(r == 0);
-          pid = fork();
-          if(pid < 0){
-              perror("fork");
-              exit(1);
-          }
-          if(pid == 0){
-              close(ptmp[0]);
-              dup2(ptmp[1], 1);
-              close(ptmp[1]);
-              signal(SIGALRM, settimeout);
-              alarm((int) ceil(duration));
-              run_child(test, i);
-              exit(0);
-          }
-          pipes[i] = ptmp[0];
-          close(ptmp[1]);
-      }
-      for(i = 0; i < children; i++){
-          if(wait(&status) <= 0){
-              perror("wait");
-              exit(1);
-          }
-          if (WIFSIGNALED(status))
-              fprintf(stderr, "child %d died by signal %d\n", i, WTERMSIG(status));
-      }
-  } else {
-      int ptmp[2];
-      int r = pipe(ptmp);
