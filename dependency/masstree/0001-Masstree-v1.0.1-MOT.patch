-{
-    incr = std::max(incr, client.nthreads() / 2);
-    unsigned pos = initial_pos + ((client.id() / 2) % incr);
-    unsigned n = 0;
-    Json result = Json();
-
-    double t0 = client.now();
-    if (client.id() % 2) {
-        while (!client.get_sync(pos + 16 * incr)) {
-            /* spin */
