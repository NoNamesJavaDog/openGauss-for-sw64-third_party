-
-    decimal:
-    case 4:
-        position = 4;
-        if (first != last && in_range(*first, '0', '9' + 1)) {
-            ++first;
-            position = 5;
-        }
-        /* fallthru */
-    case 5:
-        while (first != last && in_range(*first, '0', '9' + 1))
-            ++first;
-        if (first != last && position == 5)
