-inline const char *threadtype(int type) {
-  switch (type) {
-    case threadinfo::TI_MAIN:
-      return "main";
-    case threadinfo::TI_PROCESS:
-      return "process";
-    case threadinfo::TI_LOG:
-      return "log";
-    case threadinfo::TI_CHECKPOINT:
-      return "checkpoint";
-    default:
-      always_assert(0 && "Unknown threadtype");
