-// Array internals
-
-Json::ArrayJson* Json::ArrayJson::make(int n) {
-    int cap = n < 8 ? 8 : n;
-    char* buf = new char[sizeof(ArrayJson) + cap * sizeof(Json)];
-    return new((void*) buf) ArrayJson(cap);
-}
