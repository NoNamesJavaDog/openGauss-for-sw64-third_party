-              const char* end_vstr = clp->vstr + strlen(clp->vstr);
-              if (param.assign_parse(eqchr + 1, end_vstr)) {
-                  // OK, param was valid JSON
-              } else if (eqchr[1] != 0) {
-                  param = String(eqchr + 1, end_vstr);
-              } else {
-                  param = Json();
-              }
-          } else {
