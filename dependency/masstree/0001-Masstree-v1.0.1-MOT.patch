-static String log_filename(const char* logdir, int logindex) {
-    struct stat sb;
-    int r = stat(logdir, &sb);
-    if (r < 0 && errno == ENOENT) {
-        r = mkdir(logdir, 0777);
-        if (r < 0) {
-            fprintf(stderr, "%s: %s\n", logdir, strerror(errno));
-            always_assert(0);
-        }
-    }
-
-    StringAccum sa;
-    sa.snprintf(strlen(logdir) + 24, "%s/kvd-log-%d", logdir, logindex);
-    return sa.take_string();
-}
