-static double level(const std::vector<double> &v, double frac) {
-    frac *= v.size() - 1;
-    int base = (int) frac;
-    if (base == frac)
-        return v[base];
-    else
-        return v[base] * (1 - (frac - base)) + v[base + 1] * (frac - base);
-}
