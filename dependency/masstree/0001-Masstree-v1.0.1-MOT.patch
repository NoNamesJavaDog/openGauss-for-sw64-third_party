-        /* fallthru */
-    case 8:
-        position = 8;
-        if (first != last && in_range(*first, '0', '9' + 1)) {
-            ++first;
-            position = 9;
-        }
-        /* fallthru */
-    case 9:
-        while (first != last && in_range(*first, '0', '9' + 1))
