-    case 2:
-        if (first != last && *first == '0') {
-            position = 3;
-            ++first;
-        } else if (first != last && in_range(*first, '1', '9' + 1)) {
-            position = 1;
-            ++first;
-        case 1:
-            while (first != last && in_range(*first, '0', '9' + 1))
-                ++first;
-        } else
-            position = 2;
-        /* fallthru */
-    case 3:
-        if (first != last && *first == '.') {
-            ++first;
