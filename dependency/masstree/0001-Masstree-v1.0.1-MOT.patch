-inline ssize_t
-safe_write(int fd, const void *buf, size_t count)
-{
-    size_t pos = 0;
-    while (pos != count) {
-        ssize_t x = ::write(fd, buf, count - pos);
-        if (x != -1 && x != 0) {
-            buf = reinterpret_cast<const char *>(buf) + x;
-            pos += x;
-        } else if (x == 0)
-            break;
-        else if (errno != EINTR && pos == 0)
-            return -1;
-        else if (errno != EINTR)
-            break;
-    }
-    return pos;
-}
