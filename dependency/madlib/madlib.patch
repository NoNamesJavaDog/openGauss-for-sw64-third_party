-# Return the list of keras optimizers
-def get_optimizers():
-    optimizers = dict()
-    names = dir(opt)
-    for n in names:
-        optimizer = eval('opt.' + n)
-        if optimizer.__class__ == type and optimizer.__base__ == opt.Optimizer:
-            optimizers[n] = optimizer
-    return optimizers
