-    if is_platform_pg():
-        images_per_seg = plpy.execute(
-            """ SELECT count(*) AS images_per_seg
-                FROM {0}
-            """.format(table_name))
-        seg_ids = [0]
-        gp_segment_id_col = '0'
-    else:
-        # Compute total buffers on each segment
-        images_per_seg = plpy.execute(
