-            """.format(GP_SEGMENT_ID_COLNAME, table_name))
-        seg_ids = [int(image[GP_SEGMENT_ID_COLNAME]) for image in images_per_seg]
-        gp_segment_id_col = '{0}.{1}'.format(table_name,GP_SEGMENT_ID_COLNAME)
